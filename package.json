{
  "name": "userstyles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.14"
  },
  "imports": {
    "#/*": "./scripts/*"
  },
  "scripts": {
    "ci:generate": "node ./scripts/generate/main.ts",
    "ci:stylus-import": "node ./scripts/stylus-import/main.ts",
    "ci:sync-maintainers": "node ./scripts/sync-maintainers/main.ts",
    "ci:update-types": "node ./scripts/types/update-types.ts",
    "ci:bump": "node ./scripts/bump-version/main.ts",
    "lint": "node ./scripts/lint/main.ts",
    "lint:fix": "pnpm lint --fix",
    "serve": "node ./scripts/serve/main.ts",
    "test": "node --test",
    "test:update": "node --test --test-update-snapshots",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "check": "tsc && oxlint"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "@catppuccin/catppuccin": "github:catppuccin/catppuccin#d4f82739e687cfd19d168be355367fdbbcc8e029",
    "@catppuccin/palette": "^1.7.1",
    "@octokit/rest": "^21.0.2",
    "@std/assert": "jsr:^1.0.9",
    "@std/async": "jsr:^1.2.0",
    "@std/cli": "jsr:^1.0.8",
    "@std/fmt": "jsr:^1.0.2",
    "@std/path": "jsr:^1.0.8",
    "@std/yaml": "jsr:^1.0.5",
    "ajv": "8.18.0",
    "handlebars": "4.7.8",
    "json-schema-to-typescript": "^15.0.3",
    "less": "4.9.1",
    "postcss-less": "6.0.0",
    "postcss-value-parser": "4.2.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recommended": "14.0.1",
    "stylelint-config-standard": "36.0.1",
    "svgo": "4.0.0",
    "type-fest": "^4.30.2",
    "usercss-meta": "0.12.0"
  },
  "devDependencies": {
    "@types/less": "3.0.7",
    "@types/node": "^26.0.0",
    "dprint": "^0.64.3",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
