{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>catppuccin/renovate-config", "helpers:pinGitHubActionDigests"],
  packageRules: [
    // The Deno standard library keeps releasing minor/patch releases for doc updates so disabling updates to it
    {
      matchPackageNames: ["/^@jsr/std__/"],
      enabled: false,
    },
  ],
}
