{
  "typescript": {
    "deno": true,
    "ignoreNodeCommentText": "dprint-ignore",
    "ignoreFileCommentText": "dprint-ignore-file"
  },
  "json": {
    "deno": true
  },
  "markdown": {
    "deno": true,
    "textWrap": "never",
    "ignoreDirective": "dprint-ignore",
    "ignoreFileDirective": "dprint-ignore-file",
    "ignoreStartDirective": "dprint-ignore-start",
    "ignoreEndDirective": "dprint-ignore-end"
  },
  "malva": {
    "hexCase": "lower",
    "quotes": "preferDouble",
    "operatorLinebreak": "before",
    "linebreakInPseudoParens": true,
    "attrValueQuotes": "always",
    "ignoreCommentDirective": "dprint-ignore",
    "trailingComma": true
  },
  "yaml": {
    "quotes": "preferDouble",
    "ignoreCommentDirective": "dprint-ignore"
  },
  "excludes": [
    ".github/ISSUE_TEMPLATE/userstyle.yml",
    ".github/*.yml",
    "styles/**/*.md",
    "scripts/generate/templates/userstyle.md",
    "pnpm-lock.yaml"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.95.5",
    "npm:@dprint/json@0.20.0",
    "npm:@dprint/markdown@0.18.0",
    "npm:dprint-plugin-malva@0.11.2",
    "npm:dprint-plugin-yaml@0.5.0"
  ]
}
